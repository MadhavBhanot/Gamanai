# Supabase pooled connection (runtime)
DATABASE_URL=postgresql://gaminai:gaminai@localhost:5432/gaminai
# Direct connection (prisma migrations / generate)
DIRECT_URL=postgresql://gaminai:gaminai@localhost:5432/gaminai

TAVILY_API_KEY=
Groq_API_Key=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL + service-role key (server-side token verification)
VITE_SUPABASE_URL=
VITE_SUPABASE_SECRET_KEY=

PORT=8000
# Comma-separated deployed frontend origins, e.g. https://gaminai.vercel.app
CORS_ORIGINS=
# Comma-separated emails that can open /admin (ops dashboard + feedback)
ADMIN_EMAILS=
GUEST_DAILY_LIMIT=5
# Answer model fallback chain, provider:model, first one serves
ANSWER_MODELS=google:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b
# Eval judge: a different model (own quota) from the answerer
JUDGE_MODEL=google:gemini-3.1-flash-lite
