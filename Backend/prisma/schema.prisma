
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
 
}



model User {
  id          String          @id        @default(uuid())
  email       String          @unique
  provider    AuthProvider
  name        String?
  supabaseId  String?         @map("postgresID")

  conversations Conversation[]

  @@map("USER")
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

model Conversation {
  id       String   @id @default(uuid())
  title   String?
  slug   String   
  userId  String 
  user    User     @relation(fields: [userId], references: [id])
  messages Message[]
}

model Message {
  id            Int   @id @default(autoincrement())
  conversationId String
  content        String
  role           MessageRole
  createdAt      DateTime @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id])
}

enum MessageRole {
  USER
  ASSISTANT
}

// Chunks of fetched web pages for two-stage retrieval: full-text recall over all chunks, then
// embeddings (computed lazily, only for candidates) rerank them. Deduped by (url, contentHash).
model SourceChunk {
  id             BigInt                      @id @default(autoincrement())
  url            String
  title          String
  chunkIndex     Int
  contentHash    String
  content        String
  embedding      Unsupported("vector(768)")?
  embeddingModel String?
  createdAt      DateTime                    @default(now())

  @@unique([url, contentHash])
  @@index([url])
}

// Semantic answer cache (llm/cache.ts): near-identical first-turn questions within 24 h replay the stored answer.
model AnswerCache {
  id             BigInt                     @id @default(autoincrement())
  createdAt      DateTime                   @default(now())
  query          String
  mode           String
  embedding      Unsupported("vector(768)")
  embeddingModel String
  content        String
  sources        Json

  @@index([createdAt])
}

// One row per AI request, for the /admin ops dashboard. Written fire-and-forget; never blocks an answer.
model RequestLog {
  id               BigInt   @id @default(autoincrement())
  createdAt        DateTime @default(now())
  route            String // ai | follow_up | guest
  mode             String // quick | deep
  userId           String?
  conversationId   String?
  model            String?
  fellBack         Boolean  @default(false)
  ok               Boolean
  error            String?
  totalMs          Int
  ttftMs           Int?
  promptTokens     Int?
  completionTokens Int?
  researchSteps    Int?
  sourceCount      Int?

  @@index([createdAt])
}

// Thumbs up/down on an answer. Query and answer are stored as text so guest answers (never persisted) can be rated
// and a disliked answer can be turned into an eval case.
model Feedback {
  id             BigInt   @id @default(autoincrement())
  createdAt      DateTime @default(now())
  rating         Int // 1 = up, -1 = down
  userId         String?
  conversationId String?
  mode           String?
  query          String
  answer         String
  comment        String?

  @@index([createdAt])
}
