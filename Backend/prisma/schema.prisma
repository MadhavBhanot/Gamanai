
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
 
}



model User {
  id          String          @id        @default(uuid())
  email       String          @unique
  provider    AuthProvider
  name        String?
  supabaseId  String?         @map("postgresID")

  conversations Conversation[]

  @@map("USER")
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

model Conversation {
  id       String   @id @default(uuid())
  title   String?
  slug   String   
  userId  String 
  user    User     @relation(fields: [userId], references: [id])
  messages Message[]
}

model Message {
  id            Int   @id @default(autoincrement())
  conversationId String
  content        String
  role           MessageRole
  createdAt      DateTime @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id])
}

enum MessageRole {
  USER
  ASSISTANT
}

// Chunks of fetched web pages for two-stage retrieval: full-text recall over all chunks, then
// embeddings (computed lazily, only for candidates) rerank them. Deduped by (url, contentHash).
model SourceChunk {
  id             BigInt                      @id @default(autoincrement())
  url            String
  title          String
  chunkIndex     Int
  contentHash    String
  content        String
  embedding      Unsupported("vector(768)")?
  embeddingModel String?
  createdAt      DateTime                    @default(now())

  @@unique([url, contentHash])
  @@index([url])
}
